# Bot token from @BotFather
BOT_TOKEN=

# Public HTTPS address of this service.
# Clients download the install script from it, and their servers post their
# registration back to it. Agents keep a WebSocket connection to it too.
# For local work: cloudflared tunnel --url http://localhost:8080
PUBLIC_URL=https://example.com

API_HOST=0.0.0.0
API_PORT=8080
DATA_DIR=./data

# The user the install script creates on the client's server
SSH_USER=tterm

# Certificate lifetime. Deliberately short.
CERT_TTL_SECONDS=900
# A session is closed after this much idle time
SESSION_IDLE_SECONDS=1800
# Hard limit on how long a single command may run
COMMAND_TIMEOUT_SECONDS=300
# How long an install link stays valid
ENROLL_TOKEN_TTL_SECONDS=600
