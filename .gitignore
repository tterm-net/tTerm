# === SECRETS. Never commit these. ===
# .env holds the bot token — it is the bot's password.
.env
.env.*
!.env.example

# data/ holds the CA key. A leak means access to every connected server.
data/
*.pem
*_ed25519
*_rsa
*.key

# === Python environment ===
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Editors and OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# === Logs and temporary files ===
*.log
*.db
*.sqlite3
tmp/

